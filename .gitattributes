# OpenRecomp proof/module hashes bind exact text bytes. Keep source and metadata
# line endings stable across Linux and Windows checkouts.
* text=auto

*.c text eol=lf
*.h text eol=lf
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.ld text eol=lf
*.hex text eol=lf

# Golden/runtime binary artifacts must never undergo text conversion.
*.wav binary
